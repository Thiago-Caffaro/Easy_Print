# Include these directives inside the HTTPS server block that proxies Easy Print.
# Keep the byte values aligned with .env.example and compose.yaml.

client_max_body_size 27262976;
client_header_buffer_size 4k;
large_client_header_buffers 4 4k;

location / {
    proxy_pass http://easy-print-web:8080;
    proxy_http_version 1.1;
    proxy_request_buffering on;
    proxy_set_header Host $host;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
}
