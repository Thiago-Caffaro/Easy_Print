{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Thiago-Caffaro/Easy_Print/tests/Fixtures/Cups/fixture.schema.json",
  "title": "Easy Print sanitized CUPS fixture manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "fixtureVersion",
    "capturedAt",
    "cupsVersion",
    "driverFamily",
    "queueAlias",
    "locale",
    "command",
    "sourceFile",
    "expectedFile",
    "sanitizationReviewed"
  ],
  "properties": {
    "fixtureVersion": {
      "const": 1
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "cupsVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    },
    "driverFamily": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "queueAlias": {
      "type": "string",
      "pattern": "^[A-Z0-9_]+$"
    },
    "locale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32
    },
    "command": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "sourceFile": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+\\.txt$"
    },
    "expectedFile": {
      "type": "string",
      "pattern": "^[a-z0-9._-]+\\.json$"
    },
    "sanitizationReviewed": {
      "const": true
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 256
      }
    }
  }
}
